# Copy to .env (git-ignored). Never commit real keys.

# "mock" runs every agent with fake providers at no cost; "live" calls Claude.
STUDIO_MODE=mock
# Speed up mock agents (2 = twice as fast).
STUDIO_MOCK_SPEED=1

# Budget guard: the studio pauses itself when today's spend reaches this.
DAILY_BUDGET_USD=2
PER_VIDEO_BUDGET_USD=2

# Needed in live mode (real Research, Script and QA agents).
ANTHROPIC_API_KEY=
