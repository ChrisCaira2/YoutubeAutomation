{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "brief",
  "type": "object",
  "properties": {
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "promise": {
      "type": "string",
      "minLength": 1
    },
    "angle": {
      "type": "string",
      "minLength": 1
    },
    "facts": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "source_title": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "claim",
          "source_title",
          "source_url"
        ],
        "additionalProperties": false
      }
    },
    "competitors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "how_we_differ": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "title",
          "url",
          "how_we_differ"
        ],
        "additionalProperties": false
      }
    },
    "hooks": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "package_concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "thumbnail_concept": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "title",
          "thumbnail_concept"
        ],
        "additionalProperties": false
      }
    },
    "look": {
      "type": "object",
      "properties": {
        "team": {
          "type": "string"
        },
        "primary": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "secondary": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "highlight": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "background": {
          "enum": [
            "light",
            "dark"
          ]
        },
        "texture": {
          "enum": [
            "plain",
            "pinstripes",
            "grid",
            "diagonal"
          ]
        },
        "font": {
          "enum": [
            "condensed",
            "slab",
            "din",
            "futura"
          ]
        },
        "opponent": {
          "type": "string"
        },
        "opponent_primary": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "opponent_secondary": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      },
      "required": [
        "team",
        "primary",
        "secondary",
        "highlight",
        "background",
        "texture",
        "font"
      ],
      "additionalProperties": false
    },
    "pronunciations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sounds_like": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "sounds_like"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "audience",
    "promise",
    "angle",
    "facts",
    "competitors",
    "hooks",
    "package_concepts"
  ],
  "additionalProperties": false
}