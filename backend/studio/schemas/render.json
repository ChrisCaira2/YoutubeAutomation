{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "render",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1
    },
    "preview": {
      "type": "boolean"
    },
    "width": {
      "type": "integer"
    },
    "height": {
      "type": "integer"
    },
    "fps": {
      "type": "integer"
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "path",
    "preview",
    "width",
    "height",
    "fps",
    "duration_seconds"
  ],
  "additionalProperties": false
}