{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "asset_manifest",
  "type": "object",
  "properties": {
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "image",
              "narration",
              "music",
              "sfx",
              "captions",
              "thumbnail",
              "video"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "path",
          "kind",
          "source",
          "license",
          "sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "assets"
  ],
  "additionalProperties": false
}